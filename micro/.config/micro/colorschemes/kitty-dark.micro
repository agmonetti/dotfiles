# Micro colorscheme sincronizada con Kitty (DARK / Catppuccin Mocha)
color-link default "#cdd6f4,#000000"
color-link comment "#585b70"
color-link identifier "#89b4fa"
color-link constant "#f9e2af"
color-link constant.string "#a6e3a1"
color-link constant.number "#f9e2af"
color-link statement "#f5c2e7"
color-link symbol "#f38ba8"
color-link preproc "#94e2d5"
color-link type "#f9e2af"
color-link special "#f5c2e7"
color-link underlined "#89b4fa"
color-link error "bold #f38ba8"
color-link todo "bold #f9e2af"
color-link statusline "#cdd6f4,#1e1e2e"
color-link tabbar "#cdd6f4,#1e1e2e"
color-link indent-char "#585b70"
color-link line-number "#585b70,#000000"
color-link current-line-number "#cdd6f4,#000000"
color-link cursor-line ",#1e1e2e"
color-link divider "#313244,#000000"
color-link selection ",#313244"
