# Micro colorscheme sincronizada con Kitty (LIGHT / Catppuccin Latte)
color-link default "#4c4f69,#eff1f5"
color-link comment "#7c7f93"
color-link identifier "#1e66f5"
color-link constant "#df8e1d"
color-link constant.string "#40a02b"
color-link constant.number "#df8e1d"
color-link statement "#ea76cb"
color-link symbol "#d20f39"
color-link preproc "#179299"
color-link type "#df8e1d"
color-link special "#ea76cb"
color-link underlined "#1e66f5"
color-link error "bold #d20f39"
color-link todo "bold #df8e1d"
color-link statusline "#4c4f69,#e6e9ef"
color-link tabbar "#4c4f69,#e6e9ef"
color-link indent-char "#9ca0b0"
color-link line-number "#7c7f93,#eff1f5"
color-link current-line-number "#4c4f69,#eff1f5"
color-link cursor-line ",#ccd0da"
color-link divider "#bcc0cc,#eff1f5"
color-link selection ",#acb0be"
